# ============================================================
# TruMark - Environment Variables
# Copy this file to .env and fill in your values before
# running `docker compose up`.
# ============================================================

# Database Configuration
POSTGRES_DB=trumark
POSTGRES_USER=trumark
POSTGRES_PASSWORD=trumark_secret
DATABASE_URL=postgresql://trumark:trumark_secret@localhost:5432/trumark
DB_POOL_MAX=10

# Backend Security
JWT_SECRET=change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Engine ('db' or 'redis')
RATE_LIMIT_STORAGE=db
# Required if RATE_LIMIT_STORAGE=redis:
# REDIS_URL=redis://localhost:6379

# Face Recognition Provider ('insightface' or 'azure')
FACE_PROVIDER=insightface

# InsightFace Microservice Configuration
INSIGHTFACE_MODE=local
INSIGHTFACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_URL=http://localhost:8000
FACE_MODEL_NAME=buffalo_sc
FACE_SIMILARITY_THRESHOLD=0.65

# Meeting Bot Fleet Service
BOT_SERVICE_URL=http://127.0.0.1:5001
BOT_API_KEY=trumark-bot-secret

# Azure Face API (optional - only needed if FACE_PROVIDER=azure)
# AZURE_FACE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_FACE_KEY=your-azure-key-here
