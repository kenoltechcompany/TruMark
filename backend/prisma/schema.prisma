// ============================================================
// TruMark - Attendance system database schema
// Uses UUIDs for all primary keys. PostgreSQL is the datasource.
// NOTE: connection URL is configured in prisma.config.ts
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Admin users who manage the entire system.
model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

/// A class/section that students attend.
model Class {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  registrationLinkActive Boolean  @default(false) @map("registration_link_active")
  createdAt              DateTime @default(now()) @map("created_at")

  students Student[]
  sessions Session[]

  @@map("classes")
}

/// A physical or virtual classroom location with optional GPS-based geofencing.
model Classroom {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  gpsLatitude  Float    @map("gps_latitude")
  gpsLongitude Float    @map("gps_longitude")
  radiusMeters Int      @map("radius_meters")
  isVirtual    Boolean  @default(false) @map("is_virtual")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@index([name])
  @@map("classrooms")
}

/// A student enrolled in a class.
/// If isCourseRep = true, the student has course representative management rights.
model Student {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  indexNumber   String   @unique @map("index_number")
  classId       String   @map("class_id") @db.Uuid
  imagePaths    String[] @map("image_paths")
  azurePersonId String?  @map("azure_person_id")
  faceEmbedding Float[]  @default([]) @map("face_embedding")

  // Course Representative capabilities
  isCourseRep   Boolean  @default(false) @map("is_course_rep")
  username      String?  @unique
  email         String?  @unique
  passwordHash  String?  @map("password_hash")

  createdAt     DateTime @default(now()) @map("created_at")

  class      Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord[]

  @@index([classId])
  @@index([isCourseRep])
  @@map("students")
}

/// A session/meeting for attendance tracking.
model Session {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  classId     String   @map("class_id") @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at")

  class      Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  classroom  Classroom          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord[]
  onlineJob  OnlineAttendanceJob?

  @@index([classId])
  @@index([classroomId])
  @@index([startTime, endTime])
  @@map("sessions")
}

/// Records a successful check-in (biometric, web, or bot) for a student during a session.
model AttendanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  confidence Float
  createdAt  DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([sessionId])
  @@index([studentId])
  @@map("attendance_records")
}

/// Database-stored rate limit counters for distributed DDoS and abuse protection.
model RateLimit {
  key       String   @id
  totalHits Int      @default(0) @map("total_hits")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Global system configuration settings controlled by administrators.
model SystemSetting {
  id                        String   @id @default("default")
  enableLandingPage         Boolean  @default(true) @map("enable_landing_page")
  enableBiometricValidation Boolean  @default(true) @map("enable_biometric_validation")
  enableGeofencing          Boolean  @default(true) @map("enable_geofencing")

  // Student Index Number Pattern Settings
  idHasNumbers              Boolean  @default(true)  @map("id_has_numbers")
  idHasAlphabets            Boolean  @default(false) @map("id_has_alphabets")
  idMinLength               Int      @default(10)    @map("id_min_length")
  idMaxLength               Int      @default(10)    @map("id_max_length")
  idPrefix                  String?  @default("")    @map("id_prefix")
  idSuffix                  String?  @default("")    @map("id_suffix")

  // Meeting Bot Service Configuration
  botServiceUrl             String?  @default("http://127.0.0.1:5001") @map("bot_service_url")
  botApiKey                 String?  @default("trumark-bot-secret")     @map("bot_api_key")

  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum BotStatus {
  IDLE
  DISPATCHED
  READY
  WAITING_PERMISSION
  JOINED
  MONITORING
  CONCLUDING
  COMPLETED
  FAILED
}

/// Online meeting attendance job dispatched to meeting-bot-service.
model OnlineAttendanceJob {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @unique @map("session_id") @db.Uuid
  meetingUrl      String    @map("meeting_url")
  platform        String    @default("GOOGLE_MEET") @map("platform")
  isTimeBound     Boolean   @default(false) @map("is_time_bound")
  minStayMinutes  Int       @default(0) @map("min_stay_minutes")
  directWorkerUrl String?   @map("direct_worker_url")
  status          BotStatus @default(DISPATCHED)
  statusMessage   String?   @map("status_message")
  lastHeartbeat   DateTime  @default(now()) @map("last_heartbeat")
  cycleCount      Int       @default(0) @map("cycle_count")
  attendeeMinutes Json      @default("{}") @map("attendee_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@map("online_attendance_jobs")
}
