// ============================================================
// TruMark - Attendance system database schema
// Uses UUIDs for all primary keys. PostgreSQL is the datasource.
// NOTE: connection URL is configured in prisma.config.ts (not here)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma 7+)
}

/// Admin users who manage the entire system.
model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

/// Course Representatives who manage individual classes.
model CourseRep {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  classId      String?  @map("class_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  class Class? @relation(fields: [classId], references: [id])

  @@map("course_reps")
}

/// A class/section that students attend.
model Class {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  registrationLinkActive Boolean  @default(false) @map("registration_link_active")
  createdAt              DateTime @default(now()) @map("created_at")

  courseReps  CourseRep[]
  students    Student[]
  sessions    Session[]

  @@map("classes")
}

/// A session/meeting for attendance tracking.
model Session {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  classId     String   @map("class_id") @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  class     Class     @relation(fields: [classId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@map("sessions")
}

/// A physical classroom location with GPS-based geofencing.
model Classroom {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  gpsLatitude   Float    @map("gps_latitude")
  gpsLongitude  Float    @map("gps_longitude")
  radiusMeters  Int      @map("radius_meters")
  createdAt     DateTime @default(now()) @map("created_at")

  sessions    Session[]

  @@map("classrooms")
}

/// A student enrolled in a class.
model Student {
  id          String   @id @default(uuid()) @db.Uuid
  fullName    String   @map("full_name")
  indexNumber String   @unique @map("index_number")
  classId     String   @map("class_id") @db.Uuid
  imagePaths  String[] @map("image_paths")
  createdAt   DateTime @default(now()) @map("created_at")

  class Class @relation(fields: [classId], references: [id])

  @@map("students")
}
