# ============================================================
# TruMark — Environment Variables
# Copy this file to .env and fill in your values before
# running `docker compose up`.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
# Database name
POSTGRES_DB=trumark
# Database user
POSTGRES_USER=trumark
# Database password (change for production!)
POSTGRES_PASSWORD=trumark_secret

# ── Backend ─────────────────────────────────────────────────
# JWT signing secret (change for production!)
JWT_SECRET=change-me-in-production

# ── Face Recognition Provider ──────────────────────────────
# Set to 'insightface' (default, free & local on-premises) or 'azure'
FACE_PROVIDER=insightface

# InsightFace Microservice Configuration
FACE_SERVICE_URL=http://localhost:8000
FACE_MODEL_NAME=buffalo_sc
FACE_SIMILARITY_THRESHOLD=0.65

# Azure Face API (optional — only needed if FACE_PROVIDER=azure)
# AZURE_FACE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_FACE_KEY=your-azure-key-here
